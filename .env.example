# Copy to .env for local (non-docker) runs. No real secrets here.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SQLite (tests / quick local runs).
# DATABASE_URL=postgres://cod:cod@localhost:5432/cod_settlement

CELERY_BROKER_URL=redis://localhost:6379/0
# Run tasks inline without a worker (handy for local debugging):
# CELERY_TASK_ALWAYS_EAGER=true

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
REMITTANCE_MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO
